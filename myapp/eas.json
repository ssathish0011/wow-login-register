{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true,
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "icon": "./assets/icon.png"
    }
  },
  "submit": {
    "production": {}
  }
}